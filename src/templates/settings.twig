{# Manager Connector settings.

   Almost read-only. The only things this screen can change are pairing and disconnecting, and they
   are here because the console is not always available — plenty of Craft sites run on managed hosting
   with no shell, and "you need SSH" would exclude them rather than inconvenience them.

   Both actions require an administrator and a POST carrying Craft's CSRF token, and both are outbound:
   pressing a button here makes this site call the platform. Nothing on this screen lets a platform call
   in, and nothing here accepts an instruction from one.

   When platformUrl is set in config/manager-connector.php the address cannot be changed from this
   screen. That is the point of setting it: on a site configured that way, a hijacked session can only
   ever pair with the platform the operator already chose.
#}
{% import "_includes/forms.twig" as forms %}

{% set connection = connection ?? null %}

{% set configuredUrl = settings.platformUrl|default('')|trim %}

{% if connection is null %}
    <div class="readable">
        <blockquote class="note">
            <p><strong>This site is not connected to a Manager platform.</strong></p>
            <p>Ask for a single-use enrolment code in Manager, then paste it below.</p>
            <p>
                The signing key is generated on this server and never leaves it. Manager receives the
                public half only, and never an administrator password or a database credential.
            </p>
        </blockquote>
    </div>

    <form method="post" accept-charset="UTF-8">
        {{ csrfInput() }}
        {{ actionInput('manager-connector/enrol/pair') }}
        {{ redirectInput('utilities/manager-connector') }}

        {% if configuredUrl %}
            {{ forms.field({
                label: "Manager platform"|t('manager-connector'),
                instructions: "Set in config/manager-connector.php, so it cannot be changed from here."|t('manager-connector'),
            }, '<code>' ~ configuredUrl ~ '</code>') }}
        {% else %}
            {{ forms.autosuggestField({
                label: "Manager platform"|t('manager-connector'),
                instructions: "The address of your Manager installation. Must be HTTPS — a signed request over plain HTTP is still readable in transit, including the code below. Check it carefully: this is where the site's operational state will be sent."|t('manager-connector'),
                id: 'platformUrl',
                name: 'platformUrl',
                placeholder: 'https://manager.example.org',
                suggestEnvVars: true,
                required: true,
            }) }}
        {% endif %}

        {{ forms.textField({
            label: "Enrolment code"|t('manager-connector'),
            instructions: "Single-use, and it expires. Issue a fresh one in Manager if this fails."|t('manager-connector'),
            id: 'enrolmentCode',
            name: 'enrolmentCode',
            placeholder: 'mgr_enrol_…',
            required: true,
            autocomplete: false,
            class: 'code',
        }) }}

        <div class="buttons">
            <button type="submit" class="btn submit">{{ "Pair this site"|t('manager-connector') }}</button>
        </div>
    </form>
{% else %}
    {% if connection.state == 'pending_confirmation' %}
        <div class="readable">
            <blockquote class="note warning">
                <p><strong>Waiting for confirmation.</strong></p>
                <p>
                    This site paired from a different domain than the platform expected, so nothing is
                    being reported until an administrator confirms it in Manager.
                </p>
            </blockquote>
        </div>
    {% endif %}

    <table class="data fullwidth">
        <tbody>
            <tr>
                <th scope="row">{{ "Connection state"|t('manager-connector') }}</th>
                <td>
                    {% if connection.state == 'active' %}
                        <span class="status green"></span> {{ "Connected"|t('manager-connector') }}
                    {% elseif connection.state == 'pending_confirmation' %}
                        <span class="status orange"></span> {{ "Awaiting confirmation"|t('manager-connector') }}
                    {% else %}
                        <span class="status"></span> {{ "Disconnected"|t('manager-connector') }}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th scope="row">{{ "Manager platform"|t('manager-connector') }}</th>
                <td><code>{{ connection.platformUrl }}</code></td>
            </tr>
            <tr>
                <th scope="row">{{ "Site identifier"|t('manager-connector') }}</th>
                <td><code>{{ connection.siteIdentifier }}</code></td>
            </tr>
            <tr>
                <th scope="row">{{ "Enabled capabilities"|t('manager-connector') }}</th>
                <td>
                    {% set capabilities = connection.capabilities ? connection.capabilities|json_decode : [] %}
                    {% if capabilities|length %}
                        {% for capability in capabilities %}
                            <code>{{ capability }}</code>{{ not loop.last ? ', ' }}
                        {% endfor %}
                    {% else %}
                        {{ "None. This site reports nothing."|t('manager-connector') }}
                    {% endif %}
                </td>
            </tr>
            {% if 'backups:create' in capabilities %}
                <tr>
                    <th scope="row">{{ "Backups"|t('manager-connector') }}</th>
                    <td>
                        {% if connection.platformBackupPublicKey %}
                            <p>
                                {{ "This site may be asked to take a database backup. Each one is encrypted here, with a key generated on this server and sealed to the platform, before it is uploaded."|t('manager-connector') }}
                            </p>
                            <p class="light">
                                {{ "The plaintext dump is deleted as soon as it has been encrypted. Backups are uploaded to the platform this site is paired with and nowhere else; no instruction from the platform can change where they go."|t('manager-connector') }}
                            </p>
                        {% else %}
                            {# Permission without a key means no backup will be attempted. Said plainly,
                               because the alternative is an operator wondering why nothing happens. #}
                            <p class="error">
                                {{ "Permission has been granted, but the platform has not published an artifact encryption key. No backup will be taken until it does — an unencrypted database will never be uploaded."|t('manager-connector') }}
                            </p>
                        {% endif %}
                    </td>
                </tr>
            {% endif %}
            <tr>
                <th scope="row">{{ "Last successful connection"|t('manager-connector') }}</th>
                <td>{{ connection.lastSuccessAt ? connection.lastSuccessAt|datetime('short') : "Never"|t('manager-connector') }}</td>
            </tr>
            <tr>
                <th scope="row">{{ "Connector version"|t('manager-connector') }}</th>
                <td><code>{{ connectorVersion }}</code></td>
            </tr>
            <tr>
                <th scope="row">{{ "Credentials rotated"|t('manager-connector') }}</th>
                <td>{{ connection.keyRotatedAt ? connection.keyRotatedAt|datetime('short') : "Never"|t('manager-connector') }}</td>
            </tr>
            <tr>
                <th scope="row">{{ "Disconnect"|t('manager-connector') }}</th>
                <td>
                    <p class="light">
                        {{ "Deletes this site's signing key, so it stops reporting. Revoke the connector in Manager as well, or the platform will keep expecting it."|t('manager-connector') }}
                    </p>

                    <form method="post" accept-charset="UTF-8">
                        {{ csrfInput() }}
                        {{ actionInput('manager-connector/enrol/disconnect') }}
                        {{ redirectInput('utilities/manager-connector') }}

                        <div class="buttons">
                            <button type="submit" class="btn"
                                    data-confirm="{{ 'Delete this site\'s signing key? It will stop reporting until it is paired again.'|t('manager-connector') }}">
                                {{ "Disconnect"|t('manager-connector') }}
                            </button>
                        </div>
                    </form>

                    <p class="light">
                        {{ "On the console:"|t('manager-connector') }}
                        <code>php craft manager-connector/disconnect</code>
                    </p>
                </td>
            </tr>
        </tbody>
    </table>

    <div class="readable" style="margin-top: 1.5rem;">
        <p class="light">
            {{ "Manager holds only this site's public key, and never an administrator password, an SSH credential or a database password. To see exactly what this site reports, run"|t('manager-connector') }}
            <code>php craft manager-connector/preview</code>.
            <a href="{{ securityUrl }}" rel="noopener" target="_blank">{{ "Security documentation"|t('manager-connector') }}</a>
        </p>
    </div>
{% endif %}
